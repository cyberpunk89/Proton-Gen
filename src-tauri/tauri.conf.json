{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "protongen",
  "version": "0.13.1",
  "identifier": "dev.protongen.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "protongen",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Build Steam / umu Proton launch commands",
    "longDescription": "A polished GUI for building Steam launch options and umu-launcher commands for Proton on CachyOS. Scans runtimes, games and shortcuts; toggles a searchable env-var catalog; previews and copies the command.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
