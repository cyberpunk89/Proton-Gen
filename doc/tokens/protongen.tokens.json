{
  "primitives": {
    "palette": {
      "base":       { "$type": "color", "$value": "#191724", "$description": "Rosé Pine Base — app background" },
      "surface":    { "$type": "color", "$value": "#1f1d2e", "$description": "Rosé Pine Surface" },
      "overlay":    { "$type": "color", "$value": "#26233a", "$description": "Rosé Pine Overlay" },
      "overlay-hi": { "$type": "color", "$value": "#393552", "$description": "Rosé Pine Highlight Med" },
      "text":       { "$type": "color", "$value": "#e0def4", "$description": "Rosé Pine Text" },
      "subtle":     { "$type": "color", "$value": "#c9c7e0", "$description": "between Text and Subtle" },
      "muted":      { "$type": "color", "$value": "#908caa", "$description": "Rosé Pine Muted" },
      "iris":       { "$type": "color", "$value": "#c4a7e7", "$description": "Rosé Pine Iris — accent" },
      "foam":       { "$type": "color", "$value": "#9ccfd8", "$description": "Rosé Pine Foam — success/green" },
      "love":       { "$type": "color", "$value": "#eb6f92", "$description": "Rosé Pine Love — danger/red" },
      "gold":       { "$type": "color", "$value": "#f6c177", "$description": "Rosé Pine Gold — warning/yellow" },
      "rose":       { "$type": "color", "$value": "#ebbcba", "$description": "Rosé Pine Rose — attention/peach" },
      "pine":       { "$type": "color", "$value": "#31748f", "$description": "Rosé Pine Pine — info/blue" },
      "white":      { "$type": "color", "$value": "#ffffff", "$description": "control knobs, on-art text" },
      "black":      { "$type": "color", "$value": "#000000", "$description": "scrim/overlay base" }
    }
  },

  "semantic": {
    "color": {
      "bg":            { "$type": "color", "$value": "{palette.base}",          "$description": "window background base" },
      "mantle":        { "$type": "color", "$value": "{palette.surface}",       "$description": "darker inset zone / command bar" },
      "surface":       { "$type": "color", "$value": "rgba(31,29,46,0.28)",     "$description": "translucent card fill (surface 28%)" },
      "surface-solid": { "$type": "color", "$value": "{palette.surface}",       "$description": "opaque elevated surface" },
      "surface-2":     { "$type": "color", "$value": "{palette.overlay}",       "$description": "solid raised control fill" },
      "overlay":       { "$type": "color", "$value": "{palette.overlay-hi}",    "$description": "scrollbar thumb, dividers" },
      "border":        { "$type": "color", "$value": "{palette.overlay}",       "$description": "default border color" },

      "text":          { "$type": "color", "$value": "{palette.text}",          "$description": "primary text" },
      "subtext":       { "$type": "color", "$value": "{palette.subtle}",        "$description": "secondary / disabled-present text" },
      "muted":         { "$type": "color", "$value": "{palette.muted}",         "$description": "help text, captions, placeholders" },

      "accent":        { "$type": "color", "$value": "{palette.iris}",          "$description": "primary interactive, focus, selection" },
      "on-accent":     { "$type": "color", "$value": "{palette.base}",          "$description": "text/icon on an accent fill" },
      "success":       { "$type": "color", "$value": "{palette.foam}",          "$description": "installed / in-sync" },
      "danger":        { "$type": "color", "$value": "{palette.love}",          "$description": "missing / error" },
      "warning":       { "$type": "color", "$value": "{palette.gold}",          "$description": "favourite star, caution" },
      "attention":     { "$type": "color", "$value": "{palette.rose}",          "$description": "drifted / not pasted" },
      "info":          { "$type": "color", "$value": "{palette.pine}",          "$description": "Heroic badge, links" },
      "mauve":         { "$type": "color", "$value": "{palette.iris}",          "$description": "recipe chips, shortcut badge" },
      "on-art":        { "$type": "color", "$value": "{palette.white}",         "$description": "text over game art" },

      "tok": {
        "env":         { "$type": "color", "$value": "#5597b3",                 "$description": "command: KEY= env names (contrast-tuned)" },
        "value":       { "$type": "color", "$value": "{semantic.color.text}",   "$description": "command: env values" },
        "wrapper":     { "$type": "color", "$value": "{semantic.color.mauve}",  "$description": "command: wrapper program" },
        "wrapper-arg": { "$type": "color", "$value": "{semantic.color.subtext}","$description": "command: wrapper args" },
        "separator":   { "$type": "color", "$value": "{semantic.color.muted}",  "$description": "command: -- and %command%" },
        "target":      { "$type": "color", "$value": "{semantic.color.accent}", "$description": "command: %command% target" },
        "exe":         { "$type": "color", "$value": "{semantic.color.success}","$description": "command: executable path" },
        "arg":         { "$type": "color", "$value": "{semantic.color.attention}","$description": "command: trailing args" },
        "unknown":     { "$type": "color", "$value": "{semantic.color.subtext}","$description": "command: unrecognized token" }
      }
    }
  },

  "alpha": {
    "alpha": {
      "accent-07":     { "$type": "color", "$value": "rgba(196,167,231,0.07)", "$description": "command card gradient top" },
      "accent-09":     { "$type": "color", "$value": "rgba(196,167,231,0.09)", "$description": "enabled option-row background" },
      "accent-16":     { "$type": "color", "$value": "rgba(196,167,231,0.16)", "$description": "recipe chip / nav active fill" },
      "accent-22":     { "$type": "color", "$value": "rgba(196,167,231,0.22)", "$description": "segmented active / nav count pill" },
      "accent-25":     { "$type": "color", "$value": "rgba(196,167,231,0.25)", "$description": "search-match highlight" },
      "accent-35":     { "$type": "color", "$value": "rgba(196,167,231,0.35)", "$description": "text selection" },
      "success-18":    { "$type": "color", "$value": "rgba(156,207,216,0.18)", "$description": "installed chip fill" },
      "danger-18":     { "$type": "color", "$value": "rgba(235,111,146,0.18)", "$description": "missing chip fill" },
      "danger-08":     { "$type": "color", "$value": "rgba(235,111,146,0.08)", "$description": "error banner fill" },
      "danger-35":     { "$type": "color", "$value": "rgba(235,111,146,0.35)", "$description": "error banner border" },
      "warning-08":    { "$type": "color", "$value": "rgba(246,193,119,0.08)", "$description": "warning banner fill" },
      "warning-35":    { "$type": "color", "$value": "rgba(246,193,119,0.35)", "$description": "warning banner border" },
      "mauve-75":      { "$type": "color", "$value": "rgba(196,167,231,0.75)", "$description": "shortcut tile badge" },
      "info-75":       { "$type": "color", "$value": "rgba(49,116,143,0.75)",  "$description": "Heroic tile badge" },
      "border-card":   { "$type": "color", "$value": "rgba(38,35,58,0.70)",    "$description": "translucent card border" },
      "border-tile":   { "$type": "color", "$value": "rgba(38,35,58,0.60)",    "$description": "tile ring" },
      "mantle-30":     { "$type": "color", "$value": "rgba(31,29,46,0.30)",    "$description": "nav rail / command bar bg" },
      "scrim-dialog":  { "$type": "color", "$value": "rgba(0,0,0,0.50)",       "$description": "dialog backdrop" },
      "scrim-badge":   { "$type": "color", "$value": "rgba(0,0,0,0.45)",       "$description": "on-art badge background" },
      "scrim-caption": { "$type": "color", "$value": "rgba(0,0,0,0.85)",       "$description": "tile caption gradient (opaque end)" },
      "scrim-ring":    { "$type": "color", "$value": "rgba(0,0,0,0.40)",       "$description": "tier dot ring" },
      "white-70":      { "$type": "color", "$value": "rgba(255,255,255,0.70)", "$description": "inactive favourite star" }
    }
  },

  "typography": {
    "font": {
      "family": {
        "sans": { "$type": "fontFamily", "$value": "Lexend",         "$description": "UI. Full stack: Lexend, ui-sans-serif, system-ui, sans-serif" },
        "mono": { "$type": "fontFamily", "$value": "JetBrains Mono",  "$description": "command string. Fallback: Fira Code, ui-monospace, monospace" }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": "400" },
        "medium":  { "$type": "fontWeight", "$value": "500" }
      },
      "size": {
        "2xs":     { "$type": "fontSize", "$value": "10", "$description": "tile badges, recipe chips" },
        "xs-plus": { "$type": "fontSize", "$value": "11", "$description": "status pills, dense metadata" },
        "xs":      { "$type": "fontSize", "$value": "12", "$description": "help text, inputs (workhorse small)" },
        "command": { "$type": "fontSize", "$value": "13", "$description": "mono command body" },
        "sm":      { "$type": "fontSize", "$value": "14", "$description": "option labels, body (workhorse body)" },
        "base":    { "$type": "fontSize", "$value": "16" },
        "lg":      { "$type": "fontSize", "$value": "18", "$description": "dialog titles, headings" }
      },
      "line": {
        "snug":   { "$type": "lineHeight", "$value": "1.375", "$description": "labels, help, tile titles" },
        "normal": { "$type": "lineHeight", "$value": "1.5",   "$description": "default body" }
      },
      "tracking": {
        "wider": { "$type": "letterSpacing", "$value": "0.05em", "$description": "uppercase nav-rail section labels" }
      }
    }
  },

  "spacing": {
    "space": {
      "0-5": { "$type": "spacing", "$value": "2" },
      "1":   { "$type": "spacing", "$value": "4" },
      "1-5": { "$type": "spacing", "$value": "6" },
      "2":   { "$type": "spacing", "$value": "8" },
      "2-5": { "$type": "spacing", "$value": "10" },
      "3":   { "$type": "spacing", "$value": "12" },
      "4":   { "$type": "spacing", "$value": "16" },
      "5":   { "$type": "spacing", "$value": "20" },
      "6":   { "$type": "spacing", "$value": "24" },
      "8":   { "$type": "spacing", "$value": "32" },
      "10":  { "$type": "spacing", "$value": "40" },
      "12":  { "$type": "spacing", "$value": "48" }
    }
  },

  "sizing": {
    "size": {
      "icon-xs":     { "$type": "sizing", "$value": "12" },
      "icon-sm":     { "$type": "sizing", "$value": "16" },
      "icon-md":     { "$type": "sizing", "$value": "20" },
      "icon-lg":     { "$type": "sizing", "$value": "34" },
      "control":     { "$type": "sizing", "$value": "32", "$description": "square icon-button (size-8)" },
      "switch-w":    { "$type": "sizing", "$value": "38" },
      "switch-h":    { "$type": "sizing", "$value": "22" },
      "switch-knob": { "$type": "sizing", "$value": "16" },
      "field-w":     { "$type": "sizing", "$value": "160" },
      "navrail-w":   { "$type": "sizing", "$value": "240" },
      "dialog-w":    { "$type": "sizing", "$value": "512" },
      "dialog-w-sm": { "$type": "sizing", "$value": "384", "$description": "compact dialog (24rem)" },
      "popover-w":   { "$type": "sizing", "$value": "256", "$description": "presets popover (16rem)" },
      "content-max": { "$type": "sizing", "$value": "896", "$description": "builder column (max-w-4xl)" },
      "library-max": { "$type": "sizing", "$value": "1152","$description": "library column (max-w-6xl)" },
      "dot-status":  { "$type": "sizing", "$value": "10" },
      "logo":        { "$type": "sizing", "$value": "28", "$description": "app logo (size-7)" }
    }
  },

  "radius": {
    "radius": {
      "xs":      { "$type": "borderRadius", "$value": "3",    "$description": "search-match highlight" },
      "sm":      { "$type": "borderRadius", "$value": "6" },
      "md":      { "$type": "borderRadius", "$value": "8" },
      "lg":      { "$type": "borderRadius", "$value": "10",   "$description": "workhorse: buttons, inputs, chips" },
      "xl":      { "$type": "borderRadius", "$value": "12",   "$description": "tiles, option rows" },
      "popover": { "$type": "borderRadius", "$value": "14",   "$description": "popover/dropdown/drawer" },
      "card":    { "$type": "borderRadius", "$value": "16",   "$description": "cards + dialogs" },
      "full":    { "$type": "borderRadius", "$value": "9999", "$description": "pills, badges, switch, dots" }
    }
  },

  "border": {
    "border": {
      "width-hair": { "$type": "strokeWidth", "$value": "1", "$description": "default border" },
      "width-ring": { "$type": "strokeWidth", "$value": "2", "$description": "focus / selected / flash ring" }
    }
  },

  "opacity": {
    "opacity": {
      "disabled":   { "$type": "opacity", "$value": "55%", "$description": "irrelevant/dimmed rows" },
      "disabled-btn": { "$type": "opacity", "$value": "50%", "$description": "disabled buttons" },
      "hover-fill": { "$type": "opacity", "$value": "90%", "$description": "filled button hover" },
      "row-hover":  { "$type": "opacity", "$value": "40%", "$description": "off-row hover surface-2" }
    }
  },

  "$themes": [
    {
      "id": "rose-pine",
      "name": "Rosé Pine",
      "group": "protongen",
      "selectedTokenSets": {
        "primitives": "source",
        "semantic": "enabled",
        "alpha": "enabled",
        "typography": "enabled",
        "spacing": "enabled",
        "sizing": "enabled",
        "radius": "enabled",
        "border": "enabled",
        "opacity": "enabled"
      }
    }
  ],

  "$metadata": {
    "tokenSetOrder": [
      "primitives",
      "semantic",
      "alpha",
      "typography",
      "spacing",
      "sizing",
      "radius",
      "border",
      "opacity"
    ]
  }
}
